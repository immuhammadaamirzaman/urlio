# ShortlyX frontend configuration. Copy to `.env` (or `.env.local`) and adjust.

# Base URL of the ShortlyX FastAPI backend.
# Leave empty to use Vite's dev proxy (calls go to /api on the same origin).
# Set to the backend origin (e.g. http://localhost:8000) for a built/preview deploy.
VITE_API_BASE_URL=

# Shared read-only demo account, for the "Browse as a guest" button on the sign-in page.
# Set BOTH to show the button; leave either empty to hide it (visitors can still sign in
# with the credentials by hand). The address must match the backend's GUEST_EMAIL, which is
# what makes the account read-only — the server rejects every write it attempts.
# The password is public by design: it goes into the JS bundle for anyone to read, so only
# ever point this at a throwaway demo account.
VITE_GUEST_EMAIL=
VITE_GUEST_PASSWORD=
